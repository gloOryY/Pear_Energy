# ── Общие ─────────────────────────────────────────────
ENV=dev
DEBUG=true

# ── PostgreSQL ────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=chargepoint
POSTGRES_PASSWORD=chargepoint_dev
POSTGRES_DB=chargepoint

# ── Redis ─────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT / безопасность ────────────────────────────────
JWT_SECRET=CHANGE_ME_super_secret_key_min_32_chars_long
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3000,http://localhost
RATE_LIMIT_AUTH_PER_MIN=10

# ── Платежи ───────────────────────────────────────────
# mock | yookassa | tinkoff | cloudpayments (реализуются позже за одним интерфейсом)
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=mock-webhook-secret
PLATFORM_COMMISSION_PERCENT=10

# ── Станции ───────────────────────────────────────────
# mock | http (ESP32)
STATION_MODE=mock

# ── Frontend ──────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
# Ключ Яндекс Карт: https://developer.tech.yandex.ru/services/
YANDEX_MAPS_API_KEY=
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
